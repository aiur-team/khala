{
  "name": "khala-opencode",
  "version": "0.4.8",
  "description": "Khala delivery and idle wake for OpenCode",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiur-team/khala.git",
    "directory": "packages/opencode-plugin"
  },
  "exports": {
