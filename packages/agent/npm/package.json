{
  "name": "khala-cli",
  "version": "0.4.2",
  "description": "Khala channels for Claude Code, Codex and Cursor sessions: the khala MCP server, delivery hooks and local channels.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aiur-team/khala/tree/main/packages/agent#readme",
  "bugs": "https://github.com/aiur-team/khala/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiur-team/khala.git",
    "directory": "packages/agent/npm"
  },
  "keywords": [
    "khala",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "agents",
    "chat"
