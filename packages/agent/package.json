{
  "name": "@khala/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "bin": {
    "khala": "./bin/khala.mjs"
  },
  "exports": {
    "./wake-shared": "./src/wake/shared/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "typecheck": "node ../../scripts/package-task.mjs typecheck",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests --exclude '**/*.live.test.ts'",
    "test:local-e2e": "KHALA_LOCAL_E2E=1 vitest run --config ../../vitest.config.ts --pool=forks src/local/acceptance.e2e.test.ts",
    "test:live": "KHALA_E2E_LIVE=1 NODE_EXTRA_CA_CERTS=../../.khala-local/certs/tls.crt vitest run --config ../../vitest.config.ts --pool=forks src/matrix/session.live.test.ts"
  },
  "dependencies": {
    "@khala/contracts": "workspace:*",
    "matrix-js-sdk": "42.4.0",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "vite": "7.3.6"
  }
}
