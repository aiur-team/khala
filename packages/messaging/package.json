{
  "name": "@khala/messaging",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./browser-device/index": "./src/browser-device/index.ts",
    "./channels/*": "./src/channels/*.ts",
    "./channels/fixtures/fakes": null,
    "./rooms/*": "./src/rooms/*.ts",
    "./rooms/fixtures/fakes": null,
    "./revocation/*": "./src/revocation/*.ts",
    "./recovery/*": "./src/recovery/*.ts",
    "./channel-access/exchange/*": "./src/channel-access/exchange/*.ts",
    "./local/http/*": "./src/local/http/*.ts"
  },
  "scripts": {
    "typecheck": "node ../../scripts/package-task.mjs typecheck",
    "build": "node ../../scripts/package-task.mjs build",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests",
    "test:browser": "node --import tsx --test 'src/**/*.browser.spec.ts'"
  },
  "dependencies": {
    "@khala/contracts": "workspace:*",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "tsx": "4.20.6",
    "vite": "7.3.6"
  }
}
