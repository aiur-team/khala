{
  "_comment": "Invalid delivery receipt cases for the retained decoders.",
  "cases": [
    { "name": "receipt free-text error", "decoder": "receipt", "base": "receipt", "set": { "kind": "failed", "errorCode": "writer_unavailable" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "failed receipt without an error", "decoder": "receipt", "base": "receipt", "set": { "kind": "failed" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "error code on a non-failure receipt", "decoder": "receipt", "base": "receipt", "set": { "errorCode": "timeout" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "receipt invented kind", "decoder": "receipt", "base": "receipt", "set": { "kind": "delivered" }, "error": { "code": "invalid_field", "field": "kind" } },
    { "name": "receipt from the model", "decoder": "receipt", "base": "receipt", "set": { "source": "model" }, "error": { "code": "invalid_field", "field": "source" } },
    { "name": "receipt carrying plaintext", "decoder": "receipt", "base": "receipt", "set": { "preview": "pending plaintext" }, "error": { "code": "invalid_field", "field": "preview" } },
    { "name": "receipt claiming cancellation succeeded", "decoder": "receipt", "base": "receipt", "set": { "cancellationSucceeded": true }, "error": { "code": "invalid_field", "field": "cancellationSucceeded" } },
    { "name": "receipt unknown envelope version", "decoder": "receipt", "base": "receipt", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "v1 receipt claiming agent acknowledgement", "decoder": "receiptV1", "base": "receipt", "set": { "kind": "agent_acknowledged" }, "error": { "code": "invalid_field", "field": "kind" } },
    { "name": "v1 receipt claiming agent source", "decoder": "receiptV1", "base": "receipt", "set": { "source": "agent" }, "error": { "code": "invalid_field", "field": "source" } },
    { "name": "v2 decoder receiving v1", "decoder": "receiptV2", "base": "receiptV2", "set": { "v": 1 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "v2 acknowledgement from harness", "decoder": "receiptV2", "base": "receiptV2", "set": { "source": "harness" }, "error": { "code": "invalid_field", "field": "source" } },
    { "name": "v2 non-acknowledgement from agent", "decoder": "receiptV2", "base": "receiptV2", "set": { "kind": "completed" }, "error": { "code": "invalid_field", "field": "kind" } },
    { "name": "v2 acknowledgement without evidence", "decoder": "receiptV2", "base": "receiptV2", "set": { "evidenceRef": null }, "error": { "code": "invalid_field", "field": "evidenceRef" } },
    { "name": "v2 acknowledgement carrying an error", "decoder": "receiptV2", "base": "receiptV2", "set": { "errorCode": "timeout" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "v2 failed receipt without an error", "decoder": "receiptV2", "base": "receiptV2", "set": { "kind": "failed", "source": "connector", "evidenceRef": null }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "v2 error code on a non-failure receipt", "decoder": "receiptV2", "base": "receiptV2", "set": { "kind": "completed", "source": "harness", "errorCode": "timeout" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "versioned receipt without an envelope version", "decoder": "receiptTransport", "base": "receiptV2", "remove": ["v"], "error": { "code": "invalid_field", "field": "v" } },
    { "name": "versioned receipt unknown envelope version", "decoder": "receiptTransport", "base": "receiptV2", "set": { "v": 3 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "versioned receipt carrying plaintext", "decoder": "receiptTransport", "base": "receiptV2", "set": { "preview": "read plaintext" }, "error": { "code": "invalid_field", "field": "preview" } }
  ]
}
