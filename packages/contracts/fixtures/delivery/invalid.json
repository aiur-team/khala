{
  "_comment": "KHA-106 invalid values. `cases` are decoder failures: each starts from the named exact-release.json value, applies `set` (dot path -> value; numeric segments index arrays) and `remove` (top-level keys), then must fail with exactly `error`. No case may decode to a typed success. `peers` are well-formed values that must still be refused by meaning; see that section's comment.",
  "cases": [
    { "name": "wrong digest prefix", "decoder": "eventRef", "base": "eventRef", "set": { "contentDigest": "sha512:f16c1e5a70000f33eebc69c8ecf82d1ab7360fcdd15121ac3293f1afd4d4ea6b" }, "error": { "code": "invalid_field", "field": "contentDigest" } },
    { "name": "digest with a trailing hex digit", "decoder": "eventRef", "base": "eventRef", "set": { "contentDigest": "sha256:f16c1e5a70000f33eebc69c8ecf82d1ab7360fcdd15121ac3293f1afd4d4ea6b0" }, "error": { "code": "invalid_field", "field": "contentDigest" } },
    { "name": "digest with a leading prefix", "decoder": "eventRef", "base": "eventRef", "set": { "contentDigest": "xsha256:f16c1e5a70000f33eebc69c8ecf82d1ab7360fcdd15121ac3293f1afd4d4ea6b" }, "error": { "code": "invalid_field", "field": "contentDigest" } },
    { "name": "uppercase digest", "decoder": "eventRef", "base": "eventRef", "set": { "contentDigest": "sha256:F16C1E5A70000F33EEBC69C8ECF82D1AB7360FCDD15121AC3293F1AFD4D4EA6B" }, "error": { "code": "invalid_field", "field": "contentDigest" } },
    { "name": "event ref unknown envelope version", "decoder": "eventRef", "base": "eventRef", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "event ref missing author device", "decoder": "eventRef", "base": "eventRef", "remove": ["authorDeviceId"], "error": { "code": "invalid_field", "field": "authorDeviceId" } },
    { "name": "event ref carrying rendered text", "decoder": "eventRef", "base": "eventRef", "set": { "renderedBody": "not canonical" }, "error": { "code": "invalid_field", "field": "renderedBody" } },
    { "name": "event ref without a content digest", "decoder": "eventRef", "base": "eventRef", "remove": ["contentDigest"], "error": { "code": "invalid_field", "field": "contentDigest" } },

    { "name": "binding unknown envelope version", "decoder": "binding", "base": "binding", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "binding negative generation", "decoder": "binding", "base": "binding", "set": { "generation": -1 }, "error": { "code": "invalid_field", "field": "generation" } },
    { "name": "binding fractional generation", "decoder": "binding", "base": "binding", "set": { "generation": 1.5 }, "error": { "code": "invalid_field", "field": "generation" } },
    { "name": "binding carrying a model", "decoder": "binding", "base": "binding", "set": { "model": "any" }, "error": { "code": "invalid_field", "field": "model" } },

    { "name": "empty selection", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "selection": [] }, "error": { "code": "invalid_field", "field": "selection" } },
    { "name": "selection over the configured limit", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "selection.2": { "v": 1, "roomId": "room-1", "eventId": "event-a-9", "authorParticipantId": "agent-a", "authorDeviceId": "dev-a", "contentDigest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" } }, "error": { "code": "limit_exceeded", "field": "selection" } },
    { "name": "duplicate event identity with another digest", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "selection.1.eventId": "event-a-7" }, "error": { "code": "invalid_field", "field": "selection[1].eventId" } },
    { "name": "mixed-room selection", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "selection.1.roomId": "room-2" }, "error": { "code": "invalid_field", "field": "selection[1].roomId" } },
    { "name": "selection outside the command room", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "roomId": "room-2" }, "error": { "code": "invalid_field", "field": "selection[0].roomId" } },
    { "name": "unavailable event ref in a selection", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "selection.0": { "v": 1, "roomId": "room-1", "eventId": "event-a-7", "authorParticipantId": "agent-a", "authorDeviceId": "dev-a" } }, "error": { "code": "invalid_field", "field": "selection[0].contentDigest" } },
    { "name": "non-UTC issuedAt", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "issuedAt": "2026-09-18T00:00:00+00:00" }, "error": { "code": "invalid_field", "field": "issuedAt" } },
    { "name": "issuedAt without a zone", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "issuedAt": "2026-09-18T00:00:00" }, "error": { "code": "invalid_field", "field": "issuedAt" } },
    { "name": "calendar-invalid issuedAt", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "issuedAt": "2026-02-30T00:00:00Z" }, "error": { "code": "invalid_field", "field": "issuedAt" } },
    { "name": "unsafe expected policy version", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "expectedPolicyVersion": 9007199254740992 }, "error": { "code": "invalid_field", "field": "expectedPolicyVersion" } },
    { "name": "negative expected binding generation", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "expectedBindingGeneration": -1 }, "error": { "code": "invalid_field", "field": "expectedBindingGeneration" } },
    { "name": "approval unknown envelope version", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "approval without a command ID", "decoder": "approvalCommand", "base": "approvalCommand", "remove": ["commandId"], "error": { "code": "invalid_field", "field": "commandId" } },
    { "name": "approval carrying an owner ID", "decoder": "approvalCommand", "base": "approvalCommand", "set": { "ownerId": "owner-b" }, "error": { "code": "invalid_field", "field": "ownerId" } },

    { "name": "policy mode outside review and auto", "decoder": "policySetCommand", "base": "policySetCommand", "set": { "mode": "sometimes" }, "error": { "code": "invalid_field", "field": "mode" } },
    { "name": "numeric paused flag", "decoder": "policySetCommand", "base": "policySetCommand", "set": { "paused": 0 }, "error": { "code": "invalid_field", "field": "paused" } },
    { "name": "policy command unknown envelope version", "decoder": "policySetCommand", "base": "policySetCommand", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "policy command carrying a pending selection", "decoder": "policySetCommand", "base": "policySetCommand", "set": { "selection": [] }, "error": { "code": "invalid_field", "field": "selection" } },

    { "name": "policy ack without an envelope version", "decoder": "policyAck", "base": "policyAck", "remove": ["v"], "error": { "code": "invalid_field", "field": "v" } },
    { "name": "policy ack unknown envelope version", "decoder": "policyAck", "base": "policyAck", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "effective ack with no requested version", "decoder": "policyAck", "base": "policyAck", "set": { "requestedVersion": null }, "error": { "code": "invalid_field", "field": "requestedVersion" } },
    { "name": "effective ack with no observed version", "decoder": "policyAck", "base": "policyAck", "set": { "effectiveVersion": null }, "error": { "code": "invalid_field", "field": "effectiveVersion" } },
    { "name": "effective ack for another version", "decoder": "policyAck", "base": "policyAck", "set": { "effectiveVersion": 5 }, "error": { "code": "invalid_field", "field": "effectiveVersion" } },
    { "name": "effective ack carrying an error", "decoder": "policyAck", "base": "policyAck", "set": { "errorCode": "outcome_unknown" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "rejected ack without an error", "decoder": "policyAck", "base": "policyAck", "set": { "connectorState": "rejected" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "rejected ack with free-text error", "decoder": "policyAck", "base": "policyAck", "set": { "connectorState": "rejected", "errorCode": "raw provider detail" }, "error": { "code": "invalid_field", "field": "errorCode" } },

    { "name": "released job without approval provenance", "decoder": "releasedJob", "base": "releasedJob", "remove": ["approval"], "error": { "code": "invalid_field", "field": "approval" } },
    { "name": "released job provenance for another policy version", "decoder": "releasedJob", "base": "releasedJob", "set": { "approval.policyVersion": 4 }, "error": { "code": "invalid_field", "field": "approval.policyVersion" } },
    { "name": "released job provenance for another binding generation", "decoder": "releasedJob", "base": "releasedJob", "set": { "approval.bindingGeneration": 1 }, "error": { "code": "invalid_field", "field": "approval.bindingGeneration" } },
    { "name": "released job with a malformed binding", "decoder": "releasedJob", "base": "releasedJob", "set": { "binding.generation": -1 }, "error": { "code": "invalid_field", "field": "binding.generation" } },
    { "name": "released job binding carrying extra fields", "decoder": "releasedJob", "base": "releasedJob", "set": { "binding.model": "any" }, "error": { "code": "invalid_field", "field": "binding.model" } },
    { "name": "released job unknown envelope version", "decoder": "releasedJob", "base": "releasedJob", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "released job carrying retry permission", "decoder": "releasedJob", "base": "releasedJob", "set": { "retry": true }, "error": { "code": "invalid_field", "field": "retry" } },
    { "name": "released job malformed payload digest", "decoder": "releasedJob", "base": "releasedJob", "set": { "payloadDigest": "SHA256:not-a-digest" }, "error": { "code": "invalid_field", "field": "payloadDigest" } },
    { "name": "released job from another room", "decoder": "releasedJob", "base": "releasedJob", "set": { "events.1.roomId": "room-2" }, "error": { "code": "invalid_field", "field": "events[1].roomId" } },

    { "name": "receipt free-text error", "decoder": "receipt", "base": "receipt", "set": { "kind": "failed", "errorCode": "writer_unavailable" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "failed receipt without an error", "decoder": "receipt", "base": "receipt", "set": { "kind": "failed" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "error code on a non-failure receipt", "decoder": "receipt", "base": "receipt", "set": { "errorCode": "timeout" }, "error": { "code": "invalid_field", "field": "errorCode" } },
    { "name": "receipt invented kind", "decoder": "receipt", "base": "receipt", "set": { "kind": "delivered" }, "error": { "code": "invalid_field", "field": "kind" } },
    { "name": "receipt from the model", "decoder": "receipt", "base": "receipt", "set": { "source": "model" }, "error": { "code": "invalid_field", "field": "source" } },
    { "name": "receipt carrying plaintext", "decoder": "receipt", "base": "receipt", "set": { "preview": "pending plaintext" }, "error": { "code": "invalid_field", "field": "preview" } },
    { "name": "receipt claiming cancellation succeeded", "decoder": "receipt", "base": "receipt", "set": { "cancellationSucceeded": true }, "error": { "code": "invalid_field", "field": "cancellationSucceeded" } },
    { "name": "receipt unknown envelope version", "decoder": "receipt", "base": "receipt", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },

    { "name": "boolean existing-session claim", "decoder": "capabilities", "base": "capabilities", "set": { "existingSession": true }, "error": { "code": "invalid_field", "field": "existingSession" } },
    { "name": "unscoped existing-session claim", "decoder": "capabilities", "base": "capabilities", "set": { "existingSession": "supported" }, "error": { "code": "invalid_field", "field": "existingSession" } },
    { "name": "boolean immediate-notification claim", "decoder": "capabilities", "base": "capabilities", "set": { "immediateNotification": true }, "error": { "code": "invalid_field", "field": "immediateNotification" } },
    { "name": "boolean reconcile claim", "decoder": "capabilities", "base": "capabilities", "set": { "reconcileByReleaseId": true }, "error": { "code": "invalid_field", "field": "reconcileByReleaseId" } },
    { "name": "reconcile after consumption claim", "decoder": "capabilities", "base": "capabilities", "set": { "reconcileByReleaseId": "always" }, "error": { "code": "invalid_field", "field": "reconcileByReleaseId" } },
    { "name": "tested support without evidence", "decoder": "capabilities", "base": "capabilities", "set": { "evidenceRef": null }, "error": { "code": "invalid_field", "field": "evidenceRef" } },
    { "name": "capabilities without an envelope version", "decoder": "capabilities", "base": "capabilities", "remove": ["v"], "error": { "code": "invalid_field", "field": "v" } },
    { "name": "capabilities unknown envelope version", "decoder": "capabilities", "base": "capabilities", "set": { "v": 2 }, "error": { "code": "invalid_version", "field": "v" } },
    { "name": "busy behavior omitted", "decoder": "capabilities", "base": "capabilities", "remove": ["busy"], "error": { "code": "invalid_field", "field": "busy" } },
    { "name": "invented busy behavior", "decoder": "capabilities", "base": "capabilities", "set": { "busy": "interrupt" }, "error": { "code": "invalid_field", "field": "busy" } },
    { "name": "duplicate receipt evidence", "decoder": "capabilities", "base": "capabilities", "set": { "receiptEvidence": ["completed", "completed"] }, "error": { "code": "invalid_field", "field": "receiptEvidence[1]" } },
    { "name": "invented receipt evidence", "decoder": "capabilities", "base": "capabilities", "set": { "receiptEvidence": ["prompt_delivered"] }, "error": { "code": "invalid_field", "field": "receiptEvidence[0]" } },
    { "name": "capabilities without limits", "decoder": "capabilities", "base": "capabilities", "remove": ["limits"], "error": { "code": "invalid_field", "field": "limits" } },
    { "name": "zero payload limit", "decoder": "capabilities", "base": "capabilities", "set": { "limits.maxPayloadBytes": 0 }, "error": { "code": "invalid_field", "field": "limits.maxPayloadBytes" } },
    { "name": "model allowlist field", "decoder": "capabilities", "base": "capabilities", "set": { "model": "any" }, "error": { "code": "invalid_field", "field": "model" } }
  ],
  "peers": {
    "_comment": "Plan peers that are well-formed values and must be refused by meaning, not shape. `sameApprovalCommandInput` / `samePolicySetCommandInput`: `set` applied to the exact-release.json `base` must compare to the unmodified base as `expect`. `releaseFromApproval`: `set` is applied to the release input { approval: approvalCommand, items: approvalCommand.selection, binding, policyVersion: approvalCommand.expectedPolicyVersion, release }, which must be refused with exactly `error`. `verifyReleasedJob`: `set` is applied to `releasedJob`, which must decode and then be refused against the unmodified approvalCommand with exactly `error`.",
    "cases": [
      { "name": "same command ID with identical input", "check": "sameApprovalCommandInput", "base": "approvalCommand", "set": {}, "expect": true },
      { "name": "same command ID with reordered selection", "check": "sameApprovalCommandInput", "base": "approvalCommand", "set": { "selection.0.eventId": "event-a-8", "selection.0.contentDigest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "selection.1.eventId": "event-a-7", "selection.1.contentDigest": "sha256:f16c1e5a70000f33eebc69c8ecf82d1ab7360fcdd15121ac3293f1afd4d4ea6b" }, "expect": false },
      { "name": "same command ID with a changed selected digest", "check": "sameApprovalCommandInput", "base": "approvalCommand", "set": { "selection.0.contentDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expect": false },
      { "name": "same command ID for the next binding generation", "check": "sameApprovalCommandInput", "base": "approvalCommand", "set": { "expectedBindingGeneration": 1 }, "expect": false },
      { "name": "same policy command ID switching to auto", "check": "samePolicySetCommandInput", "base": "policySetCommand", "set": { "mode": "auto" }, "expect": false },

      { "name": "changed selected digest invalidates the release", "check": "releaseFromApproval", "set": { "items.0.contentDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "error": { "code": "stale_content", "field": "items[0]" } },
      { "name": "next binding generation invalidates the release", "check": "releaseFromApproval", "set": { "binding.generation": 1 }, "error": { "code": "stale_binding", "field": "binding.generation" } },
      { "name": "stale policy version", "check": "releaseFromApproval", "set": { "policyVersion": 4 }, "error": { "code": "stale_policy", "field": "policyVersion" } },
      { "name": "release to another binding", "check": "releaseFromApproval", "set": { "binding.bindingId": "bind-b-2" }, "error": { "code": "binding_mismatch", "field": "binding.bindingId" } },
      { "name": "re-attributed selected event", "check": "releaseFromApproval", "set": { "items.0.authorParticipantId": "agent-x" }, "error": { "code": "stale_content", "field": "items[0]" } },
      { "name": "selected event from another device", "check": "releaseFromApproval", "set": { "items.1.authorDeviceId": "dev-x" }, "error": { "code": "stale_content", "field": "items[1]" } },
      { "name": "same content text in a new event", "check": "releaseFromApproval", "set": { "items.1.eventId": "event-a-9" }, "error": { "code": "selection_mismatch", "field": "items[1]" } },
      { "name": "reordered release", "check": "releaseFromApproval", "set": { "items.0.eventId": "event-a-8", "items.0.contentDigest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "items.1.eventId": "event-a-7", "items.1.contentDigest": "sha256:f16c1e5a70000f33eebc69c8ecf82d1ab7360fcdd15121ac3293f1afd4d4ea6b" }, "error": { "code": "selection_mismatch", "field": "items[0]" } },
      { "name": "partial release of an approval", "check": "releaseFromApproval", "set": { "items": [{ "v": 1, "roomId": "room-1", "eventId": "event-a-7", "authorParticipantId": "agent-a", "authorDeviceId": "dev-a", "contentDigest": "sha256:f16c1e5a70000f33eebc69c8ecf82d1ab7360fcdd15121ac3293f1afd4d4ea6b" }] }, "error": { "code": "selection_mismatch", "field": "items" } },
      { "name": "empty release of an empty approval", "check": "releaseFromApproval", "set": { "items": [], "approval.selection": [] }, "error": { "code": "selection_mismatch", "field": "items" } },
      { "name": "selected event from another room", "check": "releaseFromApproval", "set": { "items.0.roomId": "room-2", "approval.selection.0.roomId": "room-2" }, "error": { "code": "room_mismatch", "field": "items[0].roomId" } },
      { "name": "malformed release payload digest", "check": "releaseFromApproval", "set": { "release.payloadDigest": "sha256:abc" }, "error": { "code": "invalid_field", "field": "release.payloadDigest" } },
      { "name": "empty release ID", "check": "releaseFromApproval", "set": { "release.releaseId": "" }, "error": { "code": "invalid_field", "field": "release.releaseId" } },

      { "name": "release recorded under another approval", "check": "verifyReleasedJob", "set": { "approval.commandId": "approve-2" }, "error": { "code": "approval_mismatch", "field": "approval.commandId" } },
      { "name": "decoded release retargeted to the next generation", "check": "verifyReleasedJob", "set": { "binding.generation": 1, "approval.bindingGeneration": 1 }, "error": { "code": "approval_mismatch", "field": "approval.bindingGeneration" } },
      { "name": "decoded release under a later policy", "check": "verifyReleasedJob", "set": { "policyVersion": 4, "approval.policyVersion": 4 }, "error": { "code": "approval_mismatch", "field": "approval.policyVersion" } },
      { "name": "decoded release with a changed digest", "check": "verifyReleasedJob", "set": { "events.0.contentDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "error": { "code": "stale_content", "field": "items[0]" } },
      { "name": "decoded release for another binding", "check": "verifyReleasedJob", "set": { "binding.bindingId": "bind-b-2" }, "error": { "code": "binding_mismatch", "field": "binding.bindingId" } }
    ]
  }
}
