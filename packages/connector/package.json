{
  "name": "@khala/connector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./agent/*": "./src/agent/*.ts",
    "./bootstrap/*": "./src/bootstrap/*.ts",
    "./storage/*": "./src/storage/*.ts",
    "./storage/fixtures/*": null,
    "./subscription/*": "./src/subscription/*.ts",
    "./dispatch/*": "./src/dispatch/*.ts",
    "./dispatch/fixtures/*": null,
    "./retention/*": "./src/retention/*.ts",
    "./receipts/*": "./src/receipts/*.ts"
  },
  "scripts": {
    "typecheck": "node ../../scripts/package-task.mjs typecheck",
    "build": "node ../../scripts/package-task.mjs build",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@khala/contracts": "workspace:*",
    "libsodium-wrappers": "0.8.4"
  }
}
