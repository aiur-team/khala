{
  "name": "khala-browser-handoff-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2 || 24.18.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify:evidence": "node verify.mjs matrix.json",
    "live:chromium": "node run.mjs --browser chromium --trials 5 --out evidence/linux-xdg-open-generic-chromium.json",
    "live:firefox": "node run.mjs --browser firefox --trials 5 --out evidence/linux-xdg-open-generic-firefox.json"
  }
}
