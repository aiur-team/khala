# Copy to .env for an isolated local Netlify + Synapse run.
# The dev auth provider is enabled only with NODE_ENV=development and a loopback app origin.
NODE_ENV=development
KHALA_LOCAL_AUTH=enabled
KHALA_LOCAL_AUTH_EMAIL=owner@khala.local
PUBLIC_APP_ORIGIN=http://localhost:8888
PUBLIC_HOMESERVER_ORIGIN=http://127.0.0.1:8008
CONTROL_STATE_NAMESPACE=khala-local
KHALA_ADMISSION_MODE=explicit_browser_consent

# Local auth does not call OIDC, but the runtime contract still requires these placeholders.
OIDC_ISSUER=https://local.khala.invalid
OIDC_CLIENT_ID=khala-local-development
OIDC_CLIENT_SECRET=local-only-placeholder

# Match these to your disposable Synapse fixture. Never point local tests at production Synapse.
MATRIX_SERVER_NAME=localhost
MATRIX_REGISTRATION_SHARED_SECRET=replace-with-fixture-registration-secret-at-least-32-bytes
MATRIX_PASSWORD_DERIVATION_SECRET=replace-with-random-secret-at-least-32-bytes
INVITATION_HMAC_SECRET=replace-with-random-secret-at-least-32-bytes
