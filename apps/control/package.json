{
  "name": "@khala/control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth/*": "./src/auth/*.ts",
    "./invitations/*": "./src/invitations/*.ts",
    "./channel-link/*": "./src/channel-link/*.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./composition/*": "./src/composition/*.ts"
  },
  "scripts": {
    "typecheck": "node ../../scripts/package-task.mjs typecheck",
    "build": "node ../../scripts/package-task.mjs build",
    "build:functions": "node --import tsx src/runtime/discover.ts",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@khala/contracts": "workspace:*",
    "@khala/messaging": "workspace:*",
    "@netlify/blobs": "11.1.0",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "tsx": "4.20.6"
  }
}
