{
  "name": "@khala/control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth/*": "./src/auth/*.ts",
    "./invitations/*": "./src/invitations/*.ts",
    "./agent-bootstrap/*": "./src/agent-bootstrap/*.ts",
    "./channel-access/*": "./src/channel-access/*.ts",
    "./channel-discovery/bootstrap/*": "./src/channel-discovery/bootstrap/*.ts",
    "./channel-discovery/*": "./src/channel-discovery/*.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./composition/*": "./src/composition/*.ts"
  },
  "scripts": {
    "typecheck": "node ../../scripts/package-task.mjs typecheck",
    "build": "node ../../scripts/package-task.mjs build",
    "build:functions": "node --import tsx src/runtime/discover.ts",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@khala/contracts": "workspace:*",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "tsx": "4.20.6"
  }
}
