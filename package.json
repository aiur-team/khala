{
  "name": "khala",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "node --test scripts/*.test.mjs && node --test 'infra/**/*.test.ts' && pnpm -r test",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts",
    "build": "pnpm check:boundaries && pnpm -r build",
    "test:browser": "pnpm -r --if-present test:browser"
  },
  "devDependencies": {
    "@netlify/blobs": "11.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "smol-toml": "1.8.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
