{
  "name": "khala",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm check:boundaries && pnpm check:terminology",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:terminology": "node scripts/check-terminology.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm test:recovery-fixture && node --test 'infra/**/*.test.ts' 'infra/local/*.test.mjs' && pnpm -r test && pnpm test:conformance",
    "test:recovery-synapse": "node --import tsx --conditions=khala-source --test-concurrency=1 --test tests/integration/recovery/*.test.mjs",
    "test:installed-recovery": "node --import tsx --conditions=khala-source --test-concurrency=1 --test tests/integration/recovery/installed-hosted-recovery.test.mjs",
    "test:recovery-fixture": "node --test scripts/fixtures/*.test.mjs",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts",
    "stack:up": "node infra/local/stack.mjs up",
    "stack:down": "node infra/local/stack.mjs down",
    "stack:logs": "node infra/local/stack.mjs logs",
    "stack:status": "node infra/local/stack.mjs status",
    "test:external:local": "node infra/preview/external-local.mjs",
    "test:conformance": "node tests/e2e/harness/run.mjs conformance",
    "test:e2e": "node tests/e2e/harness/run.mjs e2e",
    "build": "pnpm check:boundaries && pnpm -r build",
    "test:browser": "pnpm -r --if-present test:browser",
    "acceptance:live": "tsx --conditions=khala-source scripts/acceptance/main.ts",
    "acceptance:pack": "node scripts/acceptance-pack.mjs"
  },
  "devDependencies": {
    "@netlify/blobs": "11.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "smol-toml": "1.8.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
