{
  "schemaVersion": 1,
  "name": "khala-spike",
  "displayName": "Khala Spike",
  "version": "0.1.0",
  "description": "Spike plugin that ships one stdio MCP server and one SessionStart hook.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [],
    "commands": [],
    "hooks": [
      {
        "id": "session-start-log",
        "event": "SessionStart",
        "command": ["sh", "hooks/log.sh", "SessionStart"],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [
      {
        "id": "khala-spike",
        "transport": "stdio",
        "command": ["python3", "mcp/server.py"]
      }
    ],
    "reminders": []
  }
}
